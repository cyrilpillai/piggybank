# Backend API Endpoint
# Development: http://localhost:8000/api/v1
# Production: https://api.example.com/api/v1
PIGGYBANK_API_URL=http://localhost:8000/api/v1

# Google OAuth Client ID (from Google Cloud Console)
PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Analytics 4 Measurement ID (from Google Analytics: Admin > Data Streams > Web > Measurement ID)
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Developer Login Bypass (defaults to true in development, false in production)
# PUBLIC_ENABLE_DEV_LOGIN=false
