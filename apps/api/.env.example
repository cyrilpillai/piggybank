# Application Configuration
ENVIRONMENT=development
PORT=8000

# PostgreSQL Database (Neon Serverless Connection String with asyncpg)
# Format: postgresql+asyncpg://<user>:<password>@<neon-host>/<dbname>?ssl=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?ssl=require

# Security & Authentication
JWT_SECRET=replace-with-a-secure-random-32-char-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Google OAuth 2.0 Credentials (from Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://piggybank.example.com

# Defaults
DEFAULT_BASE_CURRENCY=INR
